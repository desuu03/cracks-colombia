# Backend the Vite dev server proxies /api to.
API_PROXY_TARGET=http://localhost:8080

# Base path the browser uses for API calls. Keep /api when using the dev proxy;
# set the full backend URL in production once the backend enables CORS.
VITE_API_BASE_URL=/api

# true: perfil, búsqueda, solicitudes y notificaciones se simulan en el navegador
# (ver src/mocks/server.js). Ponlo en false cuando el backend los implemente.
VITE_USE_MOCKS=false
